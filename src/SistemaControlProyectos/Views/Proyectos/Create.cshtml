@model SistemaControlProyectos.Models.ProyectoViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Nuevo proyecto";
}

<h1>Nuevo proyecto</h1>

<div asp-validation-summary="All" class="text-danger"></div>

@if (((SelectList)ViewBag.Clientes).Count() == 0)
{
    <div class="alert alert-warning">
        Todavía no hay clientes registrados.
        <a asp-controller="Clientes" asp-action="Create">Crea uno primero</a>.
    </div>
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="ClienteId"></label>
        <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.Clientes">
            <option value="">-- Selecciona un cliente --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="TipoSistema"></label>
        <input asp-for="TipoSistema" class="form-control"
               placeholder="Planta de emergencia, solar, cogeneración, biodigestor..." />
    </div>
    <div class="form-group">
        <label asp-for="FechaInicio"></label>
        <input asp-for="FechaInicio" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="FechaFinEstimada"></label>
        <input asp-for="FechaFinEstimada" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-3">Guardar proyecto</button>
</form>
