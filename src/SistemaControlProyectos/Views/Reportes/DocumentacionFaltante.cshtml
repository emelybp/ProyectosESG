@model List<SistemaControlProyectos.Models.TipoDocumento>

@{
    ViewData["Title"] = "Documentación faltante";
}

<h1>Documentación faltante del proyecto</h1>

@if (!Model.Any())
{
    <p class="alert alert-success">Este proyecto tiene cargados todos los tipos de documento. ✅</p>
}
else
{
    <p>Aún faltan por cargar los siguientes tipos de documento:</p>
    <ul>
        @foreach (var tipo in Model)
        {
            <li>@tipo</li>
        }
    </ul>
}
