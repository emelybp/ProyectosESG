@model SistemaControlProyectos.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>Iniciar sesión</h1>
        <p class="text-muted">Sistema de Control de Proyectos — Equipos y Sistemas de Generación</p>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="Login" method="post">
            <div class="form-group mb-3">
                <label asp-for="Correo"></label>
                <input asp-for="Correo" class="form-control" autofocus />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Contrasena"></label>
                <input asp-for="Contrasena" type="password" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Entrar</button>
        </form>
    </div>
</div>
