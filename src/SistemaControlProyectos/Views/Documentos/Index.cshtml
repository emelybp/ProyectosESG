@model IEnumerable<SistemaControlProyectos.Models.DocumentoConVigenciaViewModel>

@{
    ViewData["Title"] = "Documentos del proyecto";
    int proyectoId = ViewBag.ProyectoId;
}

<h1>Documentos del proyecto</h1>

<p>
    <a asp-action="Create" asp-route-proyectoId="@proyectoId" class="btn btn-primary">Cargar documento</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Fecha de carga</th>
            <th>Vigencia</th>
            <th>Archivo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Vencido ? "table-danger" : item.PorVencer ? "table-warning" : "")">
                <td>@item.Documento.Tipo</td>
                <td>@item.Documento.FechaCarga.ToShortDateString()</td>
                <td>
                    @(item.Documento.FechaVigencia?.ToShortDateString() ?? "No aplica")
                    @if (item.Vencido)
                    {
                        <span class="badge bg-danger">Vencido</span>
                    }
                    else if (item.PorVencer)
                    {
                        <span class="badge bg-warning text-dark">Por vencer</span>
                    }
                </td>
                <td><a href="@item.Documento.RutaArchivo" target="_blank">Ver / descargar</a></td>
            </tr>
        }
    </tbody>
</table>
